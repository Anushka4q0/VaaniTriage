# Gnani API key from the Gnani / Vachana dashboard.
# Sent only as the X-API-Key-ID header. Never commit the real value.
GNANI_API_KEY=your_gnani_api_key_here

# Optional override. The default is the official production host.
GNANI_API_BASE=https://api.vachana.ai

# Set to 0 to start with an empty desk. The default loads labeled demonstration rows.
VAANI_SEED_SAMPLES=1

# Optional SQLite file. The default is data/vaani.db inside this project.
# VAANI_DB_PATH=
